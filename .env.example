# =============================================================================
# Configuracao opcional do update-moodle.sh.
#
# Este arquivo eh lido do MESMO .env do seu projeto docker-compose (o que ja
# tem DB_NAME/DB_USER etc.) — nao eh um .env separado. Copie so as linhas
# abaixo que fizerem sentido para dentro do seu .env existente.
#
# NUNCA versione um .env preenchido em um repositorio publico.
# =============================================================================

# --- Ja devem existir no seu .env do docker-compose ---
# DB_NAME=moodle
# DB_USER=moodleuser

# --- Especificas do update-moodle.sh (todas opcionais, com defaults sensatos) ---

# Nomes dos servicos no seu docker-compose.yml, se forem diferentes de
# "moodle" e "db"
#MOODLE_SERVICE=moodle
#DB_SERVICE=db

# Docroot do Moodle DENTRO do container da aplicacao
#MOODLE_CONTAINER_PATH=/var/www/moodle

# Plugins de terceiros "bundled" na mesma arvore que o git do core rastreia,
# nos quais voce aplicou patch local direto no arquivo (ex.: um fork seu de
# mod_attendance vivendo dentro de code/public/mod/attendance). O script
# confere se o conteudo mudou depois do update e avisa no log. Deixe
# comentado/vazio se nao for o seu caso.
#SENSITIVE_PLUGINS_CSV=mod/attendance

# Quantos backups (banco + codigo) manter na pasta backups/ antes de apagar
# os mais antigos
#KEEP_BACKUPS=14
